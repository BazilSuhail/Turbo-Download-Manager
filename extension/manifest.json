{
  "manifest_version": 3,
  "name": "TDM Download Capture",
  "short_name": "TDM",
  "version": "1.1.0",
  "description": "Hands browser downloads and page media to the Turbo Download Manager desktop application over native messaging.",
  "author": "Bazil Suhail and Abdullah Masood",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TDM Download Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "cookies",
    "webRequest"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "minimum_chrome_version": "102"
}
